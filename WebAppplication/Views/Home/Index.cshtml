@{
    ViewData["Title"] = "Power Fitness";
}

<!-- ================= HERO SECTION ================= -->
<section class="gym-hero w-100">
    <div class="container-fluid px-4 px-lg-5">
        <div class="row align-items-center g-5">

            <div class="col-lg-7">
                <div class="hero-content">
                    <span class="hero-badge">
                        <i class="bi bi-lightning-charge-fill"></i>
                        POWER FITNESS
                    </span>

                    <h1>
                        Your body can
                        <span>stand almost</span>
                        anything.
                    </h1>

                    <p class="hero-description">
                        It's your mind that needs convincing. Push past your limits,
                        stay committed, and transform your body into a powerhouse of
                        strength and resilience.
                    </p>

                    <div class="hero-buttons">
                        <a href="#about" class="btn btn-primary-custom">
                            Get Started
                            <i class="bi bi-arrow-right"></i>
                        </a>

                        <a href="#workouts" class="btn btn-outline-custom">
                            Explore More
                        </a>
                    </div>

                    <div class="stats-grid">
                        <div class="stat-item">
                            <strong>100+</strong>
                            <span>Total Members</span>
                        </div>

                        <div class="stat-item">
                            <strong>85</strong>
                            <span>Active Members</span>
                        </div>

                        <div class="stat-item">
                            <strong>20</strong>
                            <span>Trainers</span>
                        </div>

                        <div class="stat-item">
                            <strong>3</strong>
                            <span>Upcoming Sessions</span>
                        </div>

                        <div class="stat-item">
                            <strong>5</strong>
                            <span>Ongoing Sessions</span>
                        </div>

                        <div class="stat-item">
                            <strong>20</strong>
                            <span>Completed Sessions</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="hero-image">
                    <div class="hero-image-glow"></div>

                    <img src="~/images/Theo Vance.jpg"
                         alt="Fitness trainer"
                         class="img-fluid" />

                    <div class="floating-card">
                        <i class="bi bi-fire"></i>
                        <div>
                            <strong>Stay Strong</strong>
                            <span>Keep pushing!</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ================= MARQUEE TICKER ================= -->
<div class="gym-marquee">
    <div class="marquee-content">
        <span>OUTDOOR & ONLINE TRAINERS</span>
        <i class="bi bi-star-fill"></i>

        <span>PERSONAL TRAINING</span>
        <i class="bi bi-star-fill"></i>

        <span>LIVE CLASSES</span>
        <i class="bi bi-star-fill"></i>

        <span>PERSONAL TRAINERS</span>
        <i class="bi bi-star-fill"></i>

        <span>PERSONAL TRAINING</span>
    </div>
</div>

<!-- ================= ABOUT SECTION ================= -->
<section id="about" class="about-section py-5 w-100">
    <div class="container-fluid px-4 px-lg-5">
        <div class="row align-items-center g-5">

            <div class="col-lg-6">
                <div class="about-images">
                    <div class="about-main-image">
                        <img src="~/images/about p1.jpg"
                             alt="Fitness training"
                             class="img-fluid" />
                    </div>

                    <div class="about-small-image">
                        <img src="~/images/about p2.jpg"
                             alt="Gym training"
                             class="img-fluid" />
                    </div>

                    <div class="experience-card">
                        <strong>10+</strong>
                        <span>Years of<br />Experience</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="section-heading">
                    <span class="section-label">
                        <i class="bi bi-dumbbell"></i>
                        ABOUT US
                    </span>

                    <h2>
                        Empowering you to achieve
                        <span>your fitness goals.</span>
                    </h2>

                    <p>
                        We believe fitness is more than just a workout — it's a lifestyle.
                        With top-of-the-line facilities, certified trainers, and a supportive
                        community, we're here to inspire and guide you every step of the way.
                    </p>
                </div>

                <div class="feature-grid">
                    <div class="feature-box">
                        <i class="bi bi-person-check-fill"></i>
                        <div>
                            <h3>Personal Trainers</h3>
                            <p>Train with certified professionals.</p>
                        </div>
                    </div>

                    <div class="feature-box">
                        <i class="bi bi-calendar-check-fill"></i>
                        <div>
                            <h3>Flexible Sessions</h3>
                            <p>Choose sessions that fit your schedule.</p>
                        </div>
                    </div>

                    <div class="feature-box">
                        <i class="bi bi-graph-up-arrow"></i>
                        <div>
                            <h3>Track Progress</h3>
                            <p>Monitor your fitness journey.</p>
                        </div>
                    </div>

                    <div class="feature-box">
                        <i class="bi bi-heart-pulse-fill"></i>
                        <div>
                            <h3>Healthy Lifestyle</h3>
                            <p>Build better habits every day.</p>
                        </div>
                    </div>
                </div>

                <a href="#workouts" class="btn btn-primary-custom mt-4">
                    Start Your Journey
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

        </div>
    </div>
</section>

<!-- ================= WORKOUTS SECTION ================= -->
<section id="workouts" class="workouts-section py-5 w-100">
    <div class="container-fluid px-4 px-lg-5">
        <div class="section-heading text-center light-heading">
            <span class="section-label">WORKOUTS</span>

            <h2>
                Transform Your Body With
                <span>Dynamic Workouts</span>
            </h2>

            <p>
                Discover training sessions designed to help you become stronger,
                healthier and more confident.
            </p>
        </div>

        <div class="row g-4 mt-4">
            <div class="col-md-4">
                <div class="workout-card">
                    <img src="~/images/workout 1.jpg" alt="Group workout" />
                    <div class="workout-overlay">
                        <span>01</span>
                        <h3>Group Workout</h3>
                        <a href="#">
                            Explore
                            <i class="bi bi-arrow-up-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="workout-card">
                    <img src="~/images/workout 2.jpg" alt="Strength workout" />
                    <div class="workout-overlay">
                        <span>02</span>
                        <h3>Strength Training</h3>
                        <a href="#">
                            Explore
                            <i class="bi bi-arrow-up-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="workout-card">
                    <img src="~/images/workout 3.jpg" alt="Personal workout" />
                    <div class="workout-overlay">
                        <span>03</span>
                        <h3>Personal Training</h3>
                        <a href="#">
                            Explore
                            <i class="bi bi-arrow-up-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= WHY CHOOSE US SECTION ================= -->
<section class="why-section py-5 w-100">
    <div class="container-fluid px-4 px-lg-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="section-label">
                    <i class="bi bi-dumbbell"></i>
                    WHY CHOOSE US
                </span>

                <h2>
                    Elevate your fitness
                    <span>the right way.</span>
                </h2>

                <p class="why-description">
                    Our gym combines professional coaching, modern equipment,
                    flexible sessions and a motivating community to help you
                    achieve your goals.
                </p>

                <div class="why-item">
                    <div class="why-number">01</div>
                    <div>
                        <h3>Personalized Fitness Plans</h3>
                        <p>Every workout can be adapted to your goals, fitness level and experience.</p>
                    </div>
                </div>

                <div class="why-item">
                    <div class="why-number">02</div>
                    <div>
                        <h3>Professional Trainers</h3>
                        <p>Get guidance from experienced trainers who understand your fitness journey.</p>
                    </div>
                </div>

                <div class="why-item">
                    <div class="why-number">03</div>
                    <div>
                        <h3>Modern Equipment</h3>
                        <p>Train with equipment designed for effective and comfortable workouts.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="why-image">
                    <img src="~/images/why us images.svg"
                         alt="Why choose our gym"
                         class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</section>