@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Power Fitness</title>

    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-dark text-white d-flex flex-column min-vh-100">

    <!-- NAVBAR HEADER -->
    <header>
        <nav class="navbar navbar-expand-lg fixed-top custom-glass-nav">
            <div class="container nav-glass-container">
                <!-- اللوجو -->
                <a class="navbar-brand text-white fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-lightning-fill text-primary" style="color: var(--primary, #a3e635);"></i> POWER FITNESS
                </a>

                <!-- زر القائمة للموبايل -->
                <button class="navbar-toggler border-0 text-white shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-white"></i>
                </button>

                <!-- الروابط -->
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav gap-2 align-items-center mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Members" ? "active" : "")" asp-controller="Members" asp-action="Index">Members</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Trainers" ? "active" : "")" asp-controller="Trainers" asp-action="Index">Trainers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Sessions" ? "active" : "")" asp-controller="Sessions" asp-action="Index">Sessions</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Plan" ? "active" : "")" asp-controller="Plan" asp-action="Index">Plan</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Memberships" ? "active" : "")" asp-controller="Memberships" asp-action="Index">Memberships</a>
                        </li>

                        <!-- زر تسجيل الخروج -->
                        <li class="nav-item ms-lg-3">
                            <form class="form-inline m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button type="submit" class="nav-link btn btn-link text-danger border-0 p-0 text-decoration-none">Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT AREA -->
    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <!-- GYM FOOTER SECTION -->
    <footer class="gym-footer border-top border-secondary border-opacity-10 mt-auto">
        <div class="container py-5">
            <div class="row g-4 justify-content-between">
                <!-- Brand Info -->
                <div class="col-lg-4 col-md-6">
                    <h3 class="footer-logo mb-3">POWER<span style="color: #a3e635;">FITNESS</span></h3>
                    <p class="text-secondary mb-4">Push harder. Go further. Your fitness journey starts today with our specialized trainers and world-class equipment.</p>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h4>QUICK LINKS</h4>
                    <a asp-controller="Home" asp-action="Index" class="d-block text-secondary text-decoration-none mb-2">Home</a>
                    <a asp-controller="Plan" asp-action="Index" class="d-block text-secondary text-decoration-none">Plans</a>
                </div>

                <!-- Contact Info -->
                <div class="col-lg-3 col-md-6">
                    <h4>CONTACT US</h4>
                    <p class="mb-2"><i class="bi bi-telephone-fill me-2" style="color: #a3e635;"></i> +20 123 456 789</p>
                    <p class="mb-0"><i class="bi bi-envelope-fill me-2" style="color: #a3e635;"></i> info@powerfitness.com</p>
                </div>

                <!-- Gym Hours -->
                <div class="col-lg-3 col-md-6">
                    <h4>GYM HOURS</h4>
                    <p class="mb-1 text-white fw-bold">Monday - Friday</p>
                    <p class="small text-secondary mb-3">08:00 AM - 10:00 PM</p>
                    <p class="mb-1 text-white fw-bold">Saturday - Sunday</p>
                    <p class="small text-secondary">08:00 AM - 09:00 PM</p>
                </div>
            </div>

            <hr class="border-secondary my-4 opacity-25" />

            <!-- Footer Bottom -->
            <div class="footer-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <p class="mb-0 text-secondary">&copy; @DateTime.Now.Year Power Fitness. All rights reserved.</p>
                <div class="d-flex gap-3 text-secondary">
                    <i class="bi bi-instagram"></i>
                    <i class="bi bi-facebook"></i>
                    <i class="bi bi-twitter-x"></i>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>