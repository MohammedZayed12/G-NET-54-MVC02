@model IEnumerable<GymManagment.DataAccess.Entity.Plan>

@{
    ViewData["Title"] = "Membership Plans";
}

<div class="container-fluid px-4 px-md-5 pb-5 plans-section">

    <!-- Subtitle Small Tag -->
    <div class="text-center mb-2">
        <span class="text-uppercase fw-bold tracking-wider plans-label">
            Membership Plans
        </span>
    </div>

    <!-- Main Title & Description -->
    <div class="text-center mb-5">

        <h1 class="display-5 fw-bold text-white mb-2 plans-title">
            Choose Your Strength
        </h1>

        <p class="text-secondary small mx-auto mb-3 plans-description">
            Flexible membership plans designed to help you reach your fitness goals,
            no matter where you are starting from.
        </p>

        <!-- Add New Plan Button -->
        <div>
            <a asp-action="Create"
               class="btn rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 shadow-sm btn-main-add">

                <i class="bi bi-plus-lg fs-6"></i>
                Add New Plan

            </a>
        </div>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="row g-4 align-items-stretch justify-content-center px-lg-4">

            @foreach (var plan in Model)
            {
                <div class="col-12 col-md-6 col-xl-4 d-flex">

                    <!-- Plan Card -->
                    <div class="card w-100 border-0 rounded-4 p-4 p-lg-5 d-flex flex-column position-relative plan-card">

                        <!-- Header / Title -->
                        <div class="mb-2">

                            <span class="text-uppercase fw-bold text-secondary small tracking-wider plan-name">
                                @plan.Name
                            </span>

                        </div>


                        <!-- Price Section -->
                        <div class="d-flex align-items-baseline mb-3">

                            <span class="fs-1 fw-bold text-white me-2">
                                EGP @plan.Price.ToString("N0")
                            </span>

                            <span class="text-secondary">
                                / @plan.DurationDays Days
                            </span>

                        </div>


                        <!-- Features / Status List -->
                        <div class="mb-4 pb-3 plan-info">

                            <ul class="list-unstyled mb-0 d-flex flex-column gap-2">

                                <!-- Duration -->
                                <li class="d-flex align-items-center gap-2 text-light small">

                                    <i class="bi bi-check-square-fill"
                                       style="color: #ccff00;">
                                    </i>

                                    <span>
                                        Duration:
                                        <strong>@plan.DurationDays Days</strong>
                                    </span>

                                </li>


                                <!-- Status -->
                                <li class="d-flex align-items-center gap-2 text-light small">

                                    <i class="bi @(plan.IsActive ? "bi-check-square-fill" : "bi-x-square-fill text-danger")"
                                       style="@(plan.IsActive ? "color: #ccff00;" : "")">
                                    </i>

                                    <span>
                                        Status:

                                        @if (plan.IsActive)
                                        {
                                            <strong class="active-status">
                                                Active
                                            </strong>
                                        }
                                        else
                                        {
                                            <strong class="inactive-status">
                                                Inactive
                                            </strong>
                                        }

                                    </span>

                                </li>

                            </ul>

                        </div>


                        <!-- Description -->
                        <p class="text-secondary small mb-4 plan-description">
                            @plan.Description
                        </p>


                        <!-- Action Buttons -->
                        <div class="mt-auto pt-2">

                            <!-- View Details -->
                            <a asp-action="Details"
                               asp-route-id="@plan.Id"
                               class="btn w-100 rounded-3 fw-semibold py-2 mb-2 btn-custom-green-details">

                                <i class="bi bi-eye me-1"></i>
                                View Details

                            </a>


                            <div class="d-flex gap-2">

                                <!-- Edit -->
                                <a asp-action="Edit"
                                   asp-route-id="@plan.Id"
                                   class="btn btn-sm flex-fill rounded-3 fw-semibold py-2 d-flex align-items-center justify-content-center btn-custom-green-edit">

                                    <i class="bi bi-pencil me-1"></i>
                                    Edit

                                </a>


                                <!-- Delete / Deactivate -->
                                @if (plan.IsActive)
                                {
                                    <a asp-action="Delete"
                                       asp-route-id="@plan.Id"
                                       class="btn btn-sm flex-fill rounded-3 fw-semibold py-2 d-flex align-items-center justify-content-center btn-custom-danger">

                                        <i class="bi bi-dash-circle me-1"></i>
                                        Deactivate

                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Delete"
                                       asp-route-id="@plan.Id"
                                       class="btn btn-sm flex-fill rounded-3 fw-semibold py-2 d-flex align-items-center justify-content-center btn-custom-danger">

                                        <i class="bi bi-trash me-1"></i>
                                        Delete

                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- No Plans -->
        <div class="text-center py-5 rounded-4 shadow-sm no-plans">

            <i class="bi bi-box-seam display-1 text-secondary"></i>

            <h4 class="mt-3 text-white fw-bold">
                No Plans Available
            </h4>

            <p class="text-secondary">
                Start by creating a new membership plan.
            </p>

        </div>
    }

</div>


<style>

    /* =========================
           Main Section
           ========================= */

    .plans-section {
        width: 100%;
        padding-top: 180px;
        padding-bottom: 70px;
    }


    /* =========================
           Page Header
           ========================= */

    .plans-label {
        color: #ccff00;
        font-size: 0.85rem;
        letter-spacing: 2px;
    }

    .plans-title {
        letter-spacing: -1px;
    }

    .plans-description {
        max-width: 550px;
        color: #9ca3af !important;
    }


    /* =========================
           Plan Card
           ========================= */

    .plan-card {
        background-color: #16181a;
        /* Green border - visible but soft */
        border: 1px solid rgba(204, 255, 0, 0.35) !important;
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }


        /* Hover */
        .plan-card:hover {
            transform: translateY(-4px);
            border-color: #ccff00 !important;
            box-shadow: 0 0 15px rgba(204, 255, 0, 0.2) !important;
        }


    /* =========================
           Plan Name
           ========================= */

    .plan-name {
        letter-spacing: 1.5px;
        font-size: 0.8rem;
    }


    /* =========================
           Plan Info
           ========================= */

    .plan-info {
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .active-status {
        color: #ccff00;
    }

    .inactive-status {
        color: #9ca3af;
    }


    /* =========================
           Description
           ========================= */

    .plan-description {
        min-height: 45px;
        color: #9ca3af !important;
        line-height: 1.6;
    }


    /* =========================
           Add New Plan Button
           ========================= */

    .btn-main-add {
        background-color: #ccff00;
        color: #000000;
        transition: all 0.3s ease;
    }


        .btn-main-add:hover {
            background-color: #b5e600;
            color: #000000;
            box-shadow: 0 0 12px rgba(204, 255, 0, 0.3) !important;
            transform: translateY(-2px);
        }


    /* =========================
           View Details Button
           ========================= */

    .btn-custom-green-details {
        background-color: #26292c;
        color: #ffffff;
        border: 1px solid transparent;
        transition: all 0.3s ease;
    }


        .btn-custom-green-details:hover {
            background-color: #ccff00;
            color: #000000;
            border-color: #ccff00;
            box-shadow: 0 0 10px rgba(204, 255, 0, 0.25);
        }


    /* =========================
           Edit Button
           ========================= */

    .btn-custom-green-edit {
        background-color: #1f2225;
        color: #ffffff;
        border: 1px solid #33373b;
        transition: all 0.3s ease;
    }


        .btn-custom-green-edit:hover {
            background-color: transparent;
            color: #ccff00;
            border-color: #ccff00;
            box-shadow: 0 0 8px rgba(204, 255, 0, 0.2);
        }


    /* =========================
           Delete / Deactivate
           ========================= */

    .btn-custom-danger {
        background-color: #1f2225;
        color: #9ca3af;
        border: 1px solid #33373b;
        transition: all 0.3s ease;
    }


        .btn-custom-danger:hover {
            background-color: #dc3545;
            color: #ffffff;
            border-color: #dc3545;
            box-shadow: 0 0 10px rgba(220, 53, 69, 0.3);
        }


    /* =========================
           No Plans
           ========================= */

    .no-plans {
        background-color: #16181a;
        border: 1px solid #26292b;
    }


    /* =========================
           Mobile
           ========================= */

    @@media (max-width: 576px) {

        .plans-section {
            padding-top: 120px;
        }

        .plan-card {
            padding: 28px 22px !important;
        }

        .plan-description {
            min-height: auto;
        }
    }
</style>